# Description: Modern, portable, multiprotocol bootloader (x86_64 UEFI)
# URL: https://limine-bootloader.org/
# Maintainer: kryx-linux
# Depends on: nasm
# Optional: efibootmgr

name=limine
version=12.11.1
release=1
source=(https://github.com/limine-bootloader/$name/releases/download/v$version/$name-$version.tar.xz
	limine.conf.example)

build() {
	cd $name-$version

	TOOLCHAIN_FOR_TARGET="" \
	./configure \
		--prefix=/usr \
		--enable-uefi-x86-64

	make
	make DESTDIR=$PKG install

	install -D -m 0644 $SRC/limine.conf.example \
		$PKG/usr/share/$name/limine.conf.example

	rm -rf $PKG/usr/share/doc
}
