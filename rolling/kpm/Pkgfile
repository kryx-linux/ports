# Description: Binary-first package manager, CRUX pkgutils/ports replacement, and repository indexer for KryX Linux
# URL:         https://github.com/kryx-linux/kpm
# Maintainer:  kryx-linux and contributors
# Make depends on: go
# Optional:    libarchive zstd xz bzip2 gzip curl

name=kpm
version=0.6.0
release=1
source=(https://github.com/kryx-linux/$name/archive/v$version/$name-$version.tar.gz)

build() {
	cd "$name-$version"

	export CGO_ENABLED=0
	export GOOS=linux
	export GOARCH=amd64
	export GOPROXY=off
	export GOCACHE="${PKGMK_WORK_DIR:-$SRC}/gocache"
	export GOMODCACHE="${PKGMK_WORK_DIR:-$SRC}/gomodcache"

	make VERSION="$version" DESTDIR="$PKG" install
}
